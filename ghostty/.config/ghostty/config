# Ghostty config — mirrors alacritty/.config/alacritty/alacritty.toml
# Docs: `ghostty +show-config --default --docs` or https://ghostty.org/docs/config

# Colors: generated by DankMaterialShell into ~/.config/ghostty/themes/dankcolors
theme = dankcolors

# Window
window-decoration = none
window-padding-x = 12
window-padding-y = 12
background-opacity = 1.0

# Font
font-family = Iosevka
font-size = 12

# Cursor (unfocused windows already get a hollow cursor by default)
cursor-style = block
cursor-style-blink = true

# Selection
copy-on-select = true

# New windows/tabs open in the focused terminal's directory (ghostty default, set explicitly)
window-inherit-working-directory = true

# Shell
command = fish

# Keybinds (ctrl+shift+c/v, ctrl+shift+n, ctrl+minus, ctrl+0 are ghostty defaults)
keybind = ctrl+shift+equal=increase_font_size:1
keybind = shift+enter=text:\n
keybind = ctrl+shift+enter=new_window
